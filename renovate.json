{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "ignorePaths": [".direnv/**", ".venv/**", ".ruff_cache/**"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group all Nix flake input updates into a single pull request",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs"
    },
    {
      "description": "Scope lock file maintenance to the Nix flake only",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    }
  ],
  "pyenv": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Python version in .python-version, preserving uv's '+gil' variant suffix",
      "managerFilePatterns": ["(^|/)\\.python-version$"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\\+gil\\s*$"],
      "autoReplaceStringTemplate": "{{newValue}}+gil",
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ]
}
